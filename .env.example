# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-in-production

# Database (MySQL via MAMP)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=negoride
DB_USERNAME=root
DB_PASSWORD=root
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# JWT — MUST match Laravel's JWT_SECRET for token continuity
JWT_SECRET_KEY=your-jwt-secret-from-laravel-env

# Stripe LIVE keys (from Laravel .env)
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OneSignal
ONESIGNAL_APP_ID=56ef70cd-45a3-4a66-9838-3146fbbffe77
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# App
APP_URL=https://negoride.ugnews24.info
SERVER_PORT=5000

# Receipts & statements (spec §13) — never commit real values
PUBLIC_WEB_BASE_URL=https://negoride.ca     # rating / tip / support links: {base}/open?link=negoride://...
EMAIL_PROVIDER=smtp                         # smtp | postmark | console | memory (tests)
EMAIL_FROM="NegoRide Canada <receipts@negoride.ca>"
EMAIL_REPLY_TO=
GOOGLE_MAPS_STATIC_KEY=                     # key restricted to Static Maps (URL is visible in emails); falls back to GOOGLE_MAPS_SERVER_KEY
GOOGLE_MAPS_URL_SIGNING_SECRET=             # optional: signs Static Maps URLs
PRIVATE_STORAGE_DIR=                        # local private store (default ./private_storage, encrypted)
PRIVATE_STORAGE_KEY=                        # required in production (Fernet key or secret)

# Twilio Verify / Messaging (spec §11) — the app never talks to Twilio directly
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_INBOUND_URL=                 # public URL of /api/webhooks/twilio/inbound (signature check)
TWILIO_TEST_NUMBERS=                # non-prod only, e.g. "+15555550100:123456,+15555550101:654321"
TWILIO_TEST_VOIP_NUMBERS=           # non-prod only: test numbers that behave like VoIP

# Certn — CertnCentric API (spec §14.2)
CERTN_API_KEY=                      # Authorization: Api-Key …  (expires after 365 days)
CERTN_API_BASE_URL=https://api.ca.certn.co   # sandbox: https://api.sandbox.certn.co
CERTN_WEBHOOK_SECRET=
CERTN_GROUP_ID=                     # optional

# ── v4: jobs / realtime ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0     # enables RQ workers + Socket.IO message queue
JOB_MODE=                              # rq | thread | eager (default: rq if Redis answers, else thread)
RUN_SCHEDULER=0                        # 1 = run periodic jobs inside the API process (single box dev)
CORS_ORIGINS=https://admin.negoride.ca,https://negoride.ca

# ── v4: payments ───────────────────────────────────────────────────────────
PAYMENTS_GATEWAY=stripe                # 'fake' only for local QA (refused in production)
SERVICE_FEE_PERCENTAGE=10

# ── v4: email (Postmark alternative to SMTP) ───────────────────────────────
POSTMARK_SERVER_TOKEN=
POSTMARK_STREAM=outbound
EMAIL_LOGO_URL=

# ── v4: Google (server-only keys) ──────────────────────────────────────────
GOOGLE_MAPS_SERVER_KEY=                # Routes / Roads (ETA, fair price) — server only
GOOGLE_MAPS_BROWSER_KEY=               # optional, public tracking page on the API host

# ── v4: SMS extras ─────────────────────────────────────────────────────────
TWILIO_FROM_NUMBER=                    # only if no Messaging Service
TWILIO_STATUS_CALLBACK_URL=            # https://<api>/api/webhooks/twilio/status
TWILIO_VOICE_FROM=                     # caller id for SOS escalation voice alerts
SAFETY_ONCALL_PHONES=                  # +1416..., +1647...

# ── v4: private object storage (recordings, documents, receipts) ──────────
S3_ENDPOINT=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── v4: API docs ───────────────────────────────────────────────────────────
API_DOCS_PUBLIC=0                      # 1 = /api/docs without admin login (never in production)
